{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/retention",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/zalo/cron/progress-check",
      "schedule": "0 3 * * 1-6"
    },
    {
      "path": "/api/zalo/cron/draft-reminder",
      "schedule": "0 7 * * 4"
    },
    {
      "path": "/api/zalo/cron/publish-check",
      "schedule": "0 9 * * 4"
    }
  ]
}
