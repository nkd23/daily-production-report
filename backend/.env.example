# Database
DATABASE_URL=mysql+pymysql://duy1_user:duy1_password@localhost:3306/duy1_production

# JWT
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Business rule: report lock hour (24h format, server local time), e.g. 21 = 21:00
REPORT_LOCK_HOUR=21

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Timezone used for "today" / lock-time calculations
APP_TIMEZONE=Asia/Ho_Chi_Minh
