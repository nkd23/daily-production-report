# Database (SQL Server)
# Local dev (Windows Authentication against a local SQL Server instance):
DATABASE_URL=mssql+pyodbc://localhost/duy1_production?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
# Production / Docker (SQL auth against the mssql-server container):
# DATABASE_URL=mssql+pyodbc://duy1_user:StrongPassword!@db/duy1_production?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# JWT
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Business rule: report lock hour (24h format, server local time), e.g. 21 = 21:00
REPORT_LOCK_HOUR=21

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Timezone used for "today" / lock-time calculations
APP_TIMEZONE=Asia/Ho_Chi_Minh
