# Domain pointed (A record) at your Hostinger VPS IP. Caddy will auto-issue
# a free HTTPS certificate for it via Let's Encrypt on first start.
DOMAIN=baocao.example.com

# MySQL
DB_ROOT_PASSWORD=change-me-root-password
DB_NAME=duy1_production
DB_USER=duy1_user
DB_PASSWORD=change-me-db-password

# Backend
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
REPORT_LOCK_HOUR=21
APP_TIMEZONE=Asia/Ho_Chi_Minh
