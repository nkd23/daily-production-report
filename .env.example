# Settings for docker-compose.yml (self-hosted server). deploy/setup-server.sh
# generates the real .env with random secrets - this file only documents them.

# Domain pointed at the server's IP. Caddy auto-issues a free HTTPS certificate.
DOMAIN=baocao.example.com

# PostgreSQL (runs inside Docker)
DB_NAME=duy1
DB_USER=duy1
DB_PASSWORD=change-this-to-a-long-random-string

# Backend
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
# 24 = today's report stays editable until midnight, then locks.
REPORT_LOCK_HOUR=24
APP_TIMEZONE=Asia/Ho_Chi_Minh
DATA_RETENTION_DAYS=60
